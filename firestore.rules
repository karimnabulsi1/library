rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // A family member is someone who joined the library with the family code
    // (joining creates their record under people/).
    function isFamily() {
      return signedIn() && exists(/databases/$(database)/documents/libraries/nabulsi-shelves-4817/people/$(request.auth.uid));
    }

    // Each account remembers which library it belongs to. Only that person can read it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Gym Log: each person reads and writes only their own workouts, profile and bodyweight.
    match /gym/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Gym Log usernames: one account per name. Names can be looked up, nothing else is stored.
    match /gymUsernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Gym Log crews ----------
    function crewPath(cid) { return /databases/$(database)/documents/gymCrews/$(cid); }
    function crewMember(cid) {
      return signedIn() && exists(/databases/$(database)/documents/gymCrews/$(cid)/members/$(request.auth.uid));
    }
    function crewOwner(cid) {
      return signedIn() && get(crewPath(cid)).data.owner == request.auth.uid;
    }
    function okName(n) { return n is string && n.size() >= 2 && n.size() <= 30; }
    // A ranked lift must be a believable number: estimated max under the cap, ratio under 6x bodyweight.
    function okLift(r, k, cap) {
      return !(k in r) || (r[k].v is number && r[k].v > 0 && r[k].v <= cap
        && (!('ratio' in r[k]) || (r[k].ratio is number && r[k].ratio <= 6))
        && (!('hist' in r[k]) || r[k].hist.size() <= 24)
        && (!('h90' in r[k]) || (r[k].h90.v is number && r[k].h90.v <= r[k].v + 0.1))
        && (!('p90' in r[k]) || (r[k].p90.ratio is number && r[k].p90.ratio <= 6))
        && (!('s90' in r[k]) || (r[k].s90 is int && r[k].s90 <= 900))
        && (!('g30' in r[k]) || (r[k].g30 is number && r[k].g30 <= 3)));
    }
    function okStats(d) {
      return d.name is string
        && get(/databases/$(database)/documents/gymUsernames/$(d.name)).data.uid == request.auth.uid
        && d.ranked is map
        && okLift(d.ranked, 'bench', 400) && okLift(d.ranked, 'incline', 350)
        && okLift(d.ranked, 'squat', 500) && okLift(d.ranked, 'deadlift', 550)
        && okLift(d.ranked, 'ohp', 250) && okLift(d.ranked, 'row', 350)
        && okLift(d.ranked, 'pullup', 350) && okLift(d.ranked, 'dip', 350)
        && d.week.sessions <= 21 && d.week.volume <= 250000
        && d.feed.size() <= 25;
    }

    match /gymCrews/{cid} {
      // Anyone signed in can see a crew's name (shown on its invite); nothing else.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && okName(request.resource.data.name);
      allow update: if crewOwner(cid) && request.resource.data.owner == resource.data.owner && okName(request.resource.data.name);
      allow delete: if crewOwner(cid);

      // The invite code: members can see it (to share the link), only the owner sets it.
      match /secret/{doc} {
        allow read: if crewMember(cid);
        allow write: if crewOwner(cid);
      }
      // Joining needs the invite code. You can leave; the owner can remove people.
      match /members/{uid} {
        allow read: if crewMember(cid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.code == get(/databases/$(database)/documents/gymCrews/$(cid)/secret/join).data.code;
        allow delete: if signedIn() && (request.auth.uid == uid || crewOwner(cid));
      }
      // What each member shares with the crew. Only you write yours, and it must pass the checks.
      match /stats/{uid} {
        allow read: if crewMember(cid);
        allow create, update: if crewMember(cid) && request.auth.uid == uid && okStats(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // Respect: each member can only add or remove their own.
      match /respect/{eid} {
        allow read: if crewMember(cid);
        allow create: if crewMember(cid) && request.resource.data.keys().hasOnly([request.auth.uid]);
        allow update: if crewMember(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]);
      }
    }

    match /libraries/nabulsi-shelves-4817 {
      // Shelves, borrowing, edits and added books: family members only.
      match /state/{id} { allow read, write: if isFamily(); }
      match /added/{id} { allow read, write: if isFamily(); }
      match /meta/{id}  { allow read, write: if isFamily(); }

      // Names: family can see, each person changes only their own.
      // Joining (creating your record) also needs an invite for your email, so the
      // family code on its own is not enough to get in.
      match /people/{uid} {
        allow read: if isFamily();
        allow update, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/libraries/nabulsi-shelves-4817/invites/$(request.auth.token.email.lower()));
      }

      // Invites: one document per invited email (lowercase), added by a family member.
      match /invites/{email} {
        allow read, write: if isFamily();
      }

      // Reading lists, ratings and notes: visible to other family only when switched on.
      match /sections/{sid} {
        allow read: if isFamily() && (resource == null || resource.data.uid == request.auth.uid || resource.data.visible == true);
        allow create, update: if isFamily()
          && request.resource.data.uid == request.auth.uid
          && sid.matches(request.auth.uid + '__(want|reading|read|notes)');
        allow delete: if isFamily() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
